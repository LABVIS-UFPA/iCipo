{
  "manifest_version": 3,
  "name": " iCipó  ",
  "version": "1.0",
  "description": "Marca links no Google Scholar e gerencia um projeto RSL com dashboard e exportação.",
  "icons": {
    "16": "img/favicon-16x16.png",
    "48": "img/favicon-48x48.png",
    "128": "img/favicon-128x128.png"
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ICipó",
    "default_icon": {
      "16": "img/favicon-16x16.png",
      "48": "img/favicon-48x48.png",
      "128": "img/favicon-128x128.png"
    }
  },
  "options_page": "ui/options/options.html",
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
